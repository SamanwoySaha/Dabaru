// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  username      String?   @unique // Kept from original
  passwordHash  String?   // For local authentication (replaces/clarifies original 'password')
  googleId      String?   @unique // For Google OAuth
  provider      AuthProvider? // Kept from original, made optional if using googleId directly
  rating        Int       @default(1200)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt // Added as per requirement
  lastLogin     DateTime? // Kept from original

  gamesAsWhite  GameRecord[] @relation("WhitePlayerGames")
  gamesAsBlack  GameRecord[] @relation("BlackPlayerGames")
  gamesWon      GameRecord[] @relation("WinnerGames")

  @@index([rating])
}

model GameRecord {
  id                      String    @id @default(cuid())
  timeControl             String    // e.g., "RAPID1", "BLITZ2" (changed from enum)
  result                  String    // e.g., "WHITE_WINS", "BLACK_WINS", "DRAW" (changed from enum)
  status                  GameStatus // Kept from original Game model
  playedAt                DateTime  @default(now()) // Renamed from startAt
  endAt                   DateTime? // Kept from original Game model

  whitePlayerId           String
  whitePlayer             User      @relation("WhitePlayerGames", fields: [whitePlayerId], references: [id])
  whitePlayerRatingBefore Int
  whitePlayerRatingAfter  Int

  blackPlayerId           String
  blackPlayer             User      @relation("BlackPlayerGames", fields: [blackPlayerId], references: [id])
  blackPlayerRatingBefore Int
  blackPlayerRatingAfter  Int

  winnerId                String?   // Nullable if it's a draw
  winner                  User?     @relation("WinnerGames", fields: [winnerId], references: [id])

  // Fields kept from original Game model for potential utility
  startingFen             String    @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  currentFen              String?
  opening                 String?
  event                   String?

  moves                   Move[] // Kept relation to Move model

  @@index([status, result])
  @@index([whitePlayerId]) // Added for performance
  @@index([blackPlayerId]) // Added for performance
  @@index([winnerId])      // Added for performance
}

model Move {
  id          String   @id @default(cuid()) // Changed default to cuid
  gameId      String
  game        GameRecord @relation(fields: [gameId], references: [id]) // Updated relation
  moveNumber  Int
  from        String
  to          String
  comments    String?
  before      String  // FEN before move
  after       String  // FEN after move
  timeTaken   Int?     @default(0)
  createdAt   DateTime @default(now())
  san         String?   

  @@index([gameId])
}

// Enum kept from original schema
enum GameStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  TIME_UP
  PLAYER_EXIT
}

// Enum kept from original schema
enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
  GUEST
}